#--------------------------------------------------------------------
# PRANAVA NEXUS CARE - CODEIGNITER 4 ENVIRONMENT CONFIGURATION
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# APP
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'ci_session'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false
app.CSPEnabled = false

# DATABASE (MySQL / MariaDB)
database.default.hostname = localhost
database.default.database = pranava_nexus
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

# CORS
cors.allowedOrigins = ['http://localhost:3000', 'https://pranavanexuscare.com']
cors.allowedHeaders = ['Origin', 'X-Requested-With', 'Content-Type', 'Accept', 'Authorization']
cors.allowedMethods = ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS']

# INTEGRATIONS (Secrets stay on backend)
GOOGLE_MAPS_API_KEY = 
GOOGLE_PLACE_ID = 
GOOGLE_BUSINESS_PROFILE_ID = 

MAIL_HOST = smtp.mailtrap.io
MAIL_PORT = 2525
MAIL_USERNAME = 
MAIL_PASSWORD = 

WHATSAPP_NUMBER = +919876543210
