{
    "name": "pranavanexus/pranava-nexus-care-backend",
    "type": "project",
    "description": "Pranava Nexus Care - Medical Tourism & Healthcare-Travel Coordination Backend API",
    "homepage": "https://pranavanexuscare.com",
    "license": "Proprietary",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "CodeIgniter\\ComposerScripts::postUpdate"
        ],
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
